# Copy to .env and edit. Every setting in src/jolt/config.py can be set here with the JOLT_ prefix.

# --- Option A: local GGUF model on your GPU (llama.cpp) ---
JOLT_LLM_BACKEND=llamacpp
JOLT_LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
JOLT_LLM_N_GPU_LAYERS=-1

# --- Option B: Ollama or any OpenAI-compatible server ---
# JOLT_LLM_BACKEND=openai
# JOLT_OPENAI_BASE_URL=http://localhost:11434/v1
# JOLT_LLM_MODEL=qwen2.5:3b
# JOLT_OPENAI_API_KEY=not-needed

# --- Retrieval ---
JOLT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
JOLT_RERANKER_BACKEND=cross-encoder
JOLT_RETRIEVE_K=20
JOLT_RERANK_TOP_N=5

# --- Agent ---
JOLT_MAX_REWRITES=2
JOLT_WEB_SEARCH_ENABLED=true
JOLT_LEARN_FROM_WEB=false
